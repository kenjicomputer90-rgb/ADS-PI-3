<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Pos?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.GridPane?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.loja_roupas.Controller.TelaInicialController"
      stylesheets="@../../../css/style.css"
      alignment="CENTER"
      spacing="20">

    <Label text="LOJA DE ROUPAS"
           styleClass="titulo"/>

    <Label text="Sistema de Gerenciamento"
           styleClass="subtitulo"/>

    <GridPane alignment="CENTER"
              hgap="20"
              vgap="20">
    
    <Button text="Produtos"
            styleClass="menu-button"
            onAction="#abrirProdutos"
            GridPane.columnIndex="0" 
            GridPane.rowIndex="0"
            />

    <Button text="Vendas"
            styleClass="menu-button"
            onAction="#abrirVendas"
            GridPane.columnIndex="1" 
            GridPane.rowIndex="0"
            />

    <Button text="Clientes"
            styleClass="menu-button"
            GridPane.columnIndex="0" 
            GridPane.rowIndex="1"
            onAction="#abrirClientes"
            />

    <Button text="Estoque"
            styleClass="menu-button"
            onAction="#abrirEstoque"
            GridPane.columnIndex="1" 
            GridPane.rowIndex="1"
            />

    </GridPane>
</VBox>
